# CPU / NUMA isolation
CPU_CORE=34
NUMA_NODE=2

# Qwen3-8B representative KV sizes:
# 128 tokens -> 18 MiB
# 256 tokens -> 36 MiB
# 512 tokens -> 72 MiB
SIZES_MIB="18 36 72"

# Independent Python processes for each data point
PROCESS_REPEATS=5

# Per-process samples
WARMUP=5
ITERATIONS=30

# lmcache_total:
#   real AesGcmSerializer.serialize()
#
# stock_breakdown:
#   mirror current LMCache transformation and expose components
#
# raw_aes:
#   pre-materialized plaintext; cryptography AESGCM API only
MODES="lmcache_total stock_breakdown raw_aes optimized_cpu lmcache_open optimized_cpu_open"
